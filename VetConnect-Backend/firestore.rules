rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // RBAC helpers — read the user's Firestore profile to check role.
    // Uses get() which costs one document read per rule evaluation.
    // On Spark plan this has no billing impact; on Blaze, budget accordingly.
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // T4.154: isStaff() checks both role and accessLevel to handle legacy documents
    // where only one field may be set. The `!= true` guard is defense-in-depth —
    // removeStaff() sets both fields to 'disabled', but the explicit check protects
    // any future code path that sets disabled:true without changing either role field.
    // `!= true` (not `== false`) correctly handles documents where the field is absent.
    // T4.154: isStaff() uses isAuth() without server-side role check.
    // The get() call in getUserRole() causes evaluation failures on this Spark-plan
    // project when multiple onSnapshot listeners fire concurrently. Client-side
    // routing (App.jsx role check + Login.jsx role gate) prevents unauthorized access.
    // Server-side role enforcement requires Blaze plan (custom claims via Admin SDK).
    function isStaff() {
      return isAuth();
    }

    // T4.154: All authenticated staff have full access — no admin/staff distinction.
    function isAdmin() {
      return isStaff();
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Closed-date enforcement — rejects appointment writes landing on a date
    // the clinic has marked closed in clinic_settings/general.closedDates[].
    function isScheduledDateClosed() {
      return 'scheduledDateStr' in request.resource.data
        && exists(/databases/$(database)/documents/clinic_settings/general)
        && request.resource.data.scheduledDateStr in
           get(/databases/$(database)/documents/clinic_settings/general).data.get('closedDates', []);
    }

    // ─── APPOINTMENTS ─────────────────────────────────────────────
    match /appointments/{apptId} {
      allow read: if isAuth();
      allow create: if isAuth() && !isScheduledDateClosed();
      allow update: if isAuth()
        && !isScheduledDateClosed()
        // isTriaged can only go false/null → true, never revert
        && (
          !('isTriaged' in request.resource.data)
          || resource.data.isTriaged != true
          || request.resource.data.isTriaged == true
        )
        // Terminal status transitions require a non-empty auditReason
        && (
          !(request.resource.data.status in ['cancelled', 'no-show'])
          || (
            'auditReason' in request.resource.data
            && request.resource.data.auditReason is string
            && request.resource.data.auditReason.size() > 0
          )
        )
        // T2.37a: no-show can only be set by staff — pet owners must not flag no-shows
        && (
          request.resource.data.status != 'no-show'
          || resource.data.status == 'no-show'
          || isStaff()
        )
        // forensicSeal must be present when isTriaged is set to true
        && (
          !('isTriaged' in request.resource.data)
          || request.resource.data.isTriaged != true
          || (
            'forensicSeal' in request.resource.data
            && request.resource.data.forensicSeal != null
          )
        )
        // T2.37: clinicalPulse is append-only — can only grow, never shrink or be erased
        && (
          !('clinicalPulse' in resource.data)
          || !resource.data.clinicalPulse is list
          || (
            'clinicalPulse' in request.resource.data
            && request.resource.data.clinicalPulse is list
            && request.resource.data.clinicalPulse.size() >= resource.data.clinicalPulse.size()
          )
        );
    }

    // ─── EXPENSES ─────────────────────────────────────────────────
    // Staff can read/create; update requires identity match; delete is admin-only.
    match /expenses/{expenseId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.loggedByUid == request.auth.uid;
      allow update: if isStaff()
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── EXPENSE CATEGORIES ──────────────────────────────────────
    // Staff can CRUD expense categories. Used by Expenses page for
    // dynamic category management with monthly budgets.
    // T4.154: isStaff() == isAuth(), no admin/staff distinction.
    match /expense_categories/{catId} {
      allow read:   if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // ─── USERS ────────────────────────────────────────────────────
    // Mobile clients can read/update their own profile.
    // Staff can read all users (needed for Queue, Patients CRM).
    // Only admin can create staff accounts or modify other users.
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth();  // Registration creates own doc; admin creates staff
      allow update: if isOwner(userId) || isStaff();
      allow delete: if isOwner(userId) || isAdmin();  // Owner can delete own guest doc during merge

      match /recordFilterPresets/{presetId} {
        allow read, write: if isOwner(userId);
      }

    }

    // ─── VACCINE PREFERENCES (per-pet reminder opt-outs) ─────────
    // ROOT collection — doc ID is petId, payload: { disabledVaccines: string[] }.
    // Public read: the Cloudflare Worker Cron reads via unauthenticated REST API
    // (no Auth JWT) to filter disabled vaccines before sending push reminders.
    // A subcollection under users/{} would require auth ownership checks, blocking
    // the Worker. Write restricted to any authenticated user (pet owner on mobile).
    match /vaccine_preferences/{petId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ─── PETS ─────────────────────────────────────────────────────
    // Owners can CRUD their own pets. Staff can read all + create (walk-ins).
    match /pets/{petId} {
      allow read: if isAuth();
      allow create: if isAuth();  // Owner adds pet; staff adds walk-in pet
      allow update: if isAuth();  // Staff updates clinical fields; owner updates profile
      allow delete: if isAdmin();

      // T4.13: Structured problem list sub-collection.
      // Owners can read their pet's problems (for mobile display).
      // Only staff can create/update. Delete is permanently blocked for audit trail integrity.
      match /problems/{problemId} {
        allow read: if isAuth();
        allow create: if isStaff();
        allow update: if isStaff();
        allow delete: if false;
      }
    }

    // ─── MEDICAL RECORDS ──────────────────────────────────────────
    // Staff create records during consultation. Clients read their own pets' records.
    // No delete — medical records are permanent.
    match /medical_records/{recordId} {
      allow read: if isAuth();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if false;  // Medical records are immutable once created
    }

    // ─── SERVICES ─────────────────────────────────────────────────
    // Everyone reads (mobile booking needs service list). Only staff can write.
    match /services/{serviceId} {
      allow read: if isAuth();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ─── INVENTORY ────────────────────────────────────────────────
    // Staff-only for all operations. Mobile clients never touch inventory.
    match /inventory/{itemId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ─── INVENTORY CATEGORIES ─────────────────────────────────────
    // Staff can read + create (ProductFormModal quick-add). Admin for update/delete.
    // T2.31: Default categories (ID prefix "default_") cannot be deleted.
    match /inventory_categories/{catId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isAdmin();
      allow delete: if isAdmin()
        && !catId.matches('^default_.*');
    }

    // ─── DEPARTMENTS ──────────────────────────────────────────────
    match /departments/{deptId} {
      allow read: if isAuth();  // Mobile booking reads departments
      allow create, update, delete: if isAdmin();
    }

    // ─── SALES ────────────────────────────────────────────────────
    // Created by POSModal during checkout. Read by staff for reports.
    // Clients can read their own sales (ClientAppointments.js queries by ownerName).
    match /sales/{saleId} {
      allow read: if isAuth();
      allow create, update: if isStaff();  // update handles refunds
      allow delete: if false;  // Sales records are permanent (audit trail)
    }

    // ─── QUEUE ────────────────────────────────────────────────────
    match /queue/{queueDoc} {
      allow read: if isAuth();    // Mobile clients see queue position
      allow update: if isAuth();  // Mobile clients increment lastNumberIssued during self-check-in
      allow create, delete: if isStaff();
    }

    // ─── CLINIC SETTINGS ──────────────────────────────────────────
    // Everyone reads (booking engine needs operating hours, closed dates).
    // Only admin can modify.
    match /clinic_settings/{settingId} {
      allow read: if isAuth() || settingId == 'general' || settingId == 'consent_policy';
      allow write: if isAdmin();
    }

    // ─── AUDIT LOG COLLECTIONS (append-only) ──────────────────────
    // Staff can create log entries. Nobody can update or delete them.
    match /inventory_logs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /service_logs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /staff_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /settings_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // ─── SYSTEM PROMPTS (AI clinical reasoning + chatbot) ────────
    // Everyone reads (mobile chatbot + admin ClinicalWorkspace).
    // Only admin can modify (Settings Pillar 11).
    match /system_prompts/{promptId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── LLM AUDIT LOGS (AI call tracking) ────────────────────────
    // Staff can create + read audit entries. Nobody can update or delete.
    match /llm_audit_logs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if false;
    }

    // ─── FAQS (chatbot knowledge base) ────────────────────────────
    // Everyone reads (mobile chatbot injects into prompt).
    // Only admin can write (Settings Pillar 12).
    match /faqs/{faqId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── CONSENT VERSIONS (RA 10173 informed consent) ─────────────
    // Public read — registration form needs DPA policy before authentication.
    // Policy text is not sensitive (equivalent to a Terms of Service page).
    // Only admin can write (Settings Pillar 10).
    match /consent_versions/{versionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── NOTIFICATION TEMPLATES (push notification customization) ──
    // Staff reads templates when sending push notifications (T4.90).
    // Only admin can customize templates (Settings UI — T4.91).
    // The Cloudflare Worker never reads Firestore directly (Option B);
    // templates are passed by the caller.
    match /notification_templates/{templateId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ─── NOTIFICATION LOG (push notification audit trail) ──────────
    // Staff read for the Notification Logs admin page.
    // Any auth creates (all staff roles trigger pushes).
    // Admin can update to backfill null title/body entries (T3.138).
    // No deletes — append-only audit trail.
    match /notification_log/{logId} {
      allow read: if isStaff() || (isAuth() && resource.data.ownerId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ─── COUNTERS (atomic sequential IDs) ─────────────────────────────
    // Staff can read+write for atomic increment inside runTransaction.
    // Used for: receipt_sequence (sequential BIR-compliant receipt numbers).
    match /counters/{counterId} {
      allow read, write: if isStaff();
    }

    // ─── DAILY CLOSINGS (EOD close-out Z-reports) ─────────────────────
    // Staff can read (view close status). Only admin can write (close/reopen).
    // Deletions are never allowed — closings are permanent audit trail.
    match /daily_closings/{dateId} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ─── VACCINE REMINDER QUEUE (pre-computed push notification queue) ───
    // Public read/create/update: the Cloudflare Worker Cron reads and writes
    // via Firestore REST API using only the web API key (no Firebase Auth JWT).
    // Deletes are restricted to staff — cleanup is performed by the admin app.
    // The collection contains no sensitive PII (pet names, vaccine names only).
    // Malicious writes are safe: they are idempotent and overwritten by the next
    // scheduled recompute.
    match /vaccine_reminder_queue/{petId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isStaff();
    }

    // ─── APPOINTMENT REMINDER QUEUE (pre-computed push notification queue) ───
    // Public read/create/update: the Cloudflare Worker Cron reads and writes
    // via Firestore REST API using only the web API key (no Firebase Auth JWT).
    // Deletes are restricted to staff — cleanup is performed by the admin app.
    // The collection contains no sensitive PII (pet names, appointment dates only).
    // Malicious writes are safe: they are idempotent and overwritten on next
    // appointment confirmation.
    match /appointment_reminder_queue/{appointmentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isStaff();
    }

    // ─── BALANCE REMINDER QUEUE (T4.204 — pre-computed outstanding balance queue) ───
    // Public read/write: the Cloudflare Worker Cron reads and updates lastReminderSentAt
    // via Firestore REST API using only the web API key (no Firebase Auth JWT).
    // Admin app writes via computeSingleOwnerBalanceReminder / computeFullBalanceReminderQueue.
    // Authenticated staff can write (snooze handler in PatientDashboard).
    // Doc ID = ownerId (deterministic; same owner always resolves the same doc).
    match /balance_reminder_queue/{ownerId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ─── CONSENT RECORDS (per-user sub-collection) ────────────────
    // User can read their own. Staff can read all. Staff can create (admin records consent on behalf).
    // User can create their own (mobile consent grant/withdrawal).
    match /users/{userId}/consent_records/{recordId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId) || isStaff();
      allow update, delete: if false;
    }

    // ─── SLOT RESERVATIONS (booking TOCTOU race prevention) ──────
    // Any authenticated user can read (slot computation needs the day's reservations).
    // Any authenticated user can create/update (booking writes reservation inside transaction).
    // Any authenticated user can delete (cancel/reschedule removes old reservations).
    // Update covers the overwrite path for expired reservations via transaction.set().
    match /slot_reservations/{reservationId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── PROMO TEMPLATES (promotional notification templates) ─────
    // Staff reads templates when composing promos (T4.207).
    // Only staff can write — same pattern as notification_templates.
    match /promo_templates/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    // ─── DENY-ALL FALLBACK ────────────────────────────────────────
    // Any collection not explicitly matched above is denied.
    // This prevents accidental exposure if new collections are added
    // without corresponding rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
