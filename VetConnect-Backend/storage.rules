rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Clinical attachments — staff upload, authenticated read.
    // File-type and size checks mirror the client-side guards in uploadAttachment.js
    // so a misconfigured client cannot bypass the constraints.
    match /attachments/{petId}/{recordId}/{fileName} {
      // Any authenticated user can download (download URLs are already scoped to
      // the project; auth check adds defence-in-depth for direct Storage reads).
      allow read: if request.auth != null;

      // Authenticated write with hard limits — 5 MB max, JPEG/PNG/PDF only.
      // Anchored regex (^...$) prevents partial-match bypasses.
      allow write: if request.auth != null
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('^(image/jpeg|image/png|application/pdf)$');
    }
  }
}
